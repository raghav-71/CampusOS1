# Campus OS — Free AI Agent Environment Configuration
# All AI requests run strictly server-side. Do NOT add NEXT_PUBLIC_ prefixes.

# Primary Free Provider (OpenRouter)
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default Free Model on OpenRouter (Supports tool calling, reasoning & long context)
# Options:
# - meta-llama/llama-3.3-70b-instruct:free
# - google/gemini-2.0-flash-exp:free
# - deepseek/deepseek-chat:free
# - qwen/qwen-2.5-72b-instruct:free
# - openrouter/free
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Secondary Free Provider (Groq)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=
