# Campus OS — Real AI Assistant Environment Configuration
# All AI requests execute server-side. Do NOT prefix with NEXT_PUBLIC_.

# Provider Selection: "auto" (default), "ollama", "groq", "openrouter"
# - Local: auto checks localhost Ollama first, then Groq, then OpenRouter.
# - Production (Vercel): auto skips localhost and connects directly to Groq or OpenRouter.
AI_PROVIDER=auto

# ─── LOCAL DEVELOPMENT (OLLAMA) ────────────────────────────────────────────────
# Start Ollama with: ollama run qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# ─── PRODUCTION / CLOUD / VERCEL PROVIDERS ────────────────────────────────────
# 1. Groq (High Speed Free Tier — recommended for Vercel)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 2. OpenRouter (Free Tier Fallback)
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
