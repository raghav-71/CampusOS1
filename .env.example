# ==============================================================================
# CAMPUS OS — AI & SYSTEM ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local   (or on Windows: copy .env.example .env.local)
# 2. Add your preferred free API key below (Groq, OpenRouter, or Gemini).
# 3. Start CampusOS: npm run dev
#
# Note: All AI keys are SERVER-SIDE ONLY and are NEVER exposed to the browser.
# ==============================================================================

# ─── 1. AI PROVIDER SELECTION ────────────────────────────────────────────────
# Options: "auto" (default: Cloud First -> Optional Local), "groq", "openrouter", "gemini", "ollama"
AI_PROVIDER=auto

# ─── 2. GROQ CLOUD (RECOMMENDED FOR LOCAL & VERCEL) ─────────────────────────
# Get a free high-speed API key in 30 seconds at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── 3. OPENROUTER CLOUD (OPTIONAL FALLBACK) ─────────────────────────────────
# Get a free API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ─── 4. GOOGLE GEMINI (OPTIONAL) ─────────────────────────────────────────────
# Get a free Google AI API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ─── 5. LOCAL OLLAMA (OPTIONAL — LOCAL DEV ONLY) ─────────────────────────────
# Ollama is strictly optional. If not running, CampusOS automatically uses your cloud key.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# ─── 6. OPTIONAL SUPABASE (AUTH & PERSISTENCE) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
